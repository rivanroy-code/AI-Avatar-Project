{
  "name": "@tavus/embed",
  "version": "0.27.0",
  "description": "Drop a face-to-face Tavus PAL into any page with the <tavus-embed> custom element. Fully managed conversational video, no backend or API key in the browser.",
  "keywords": [
    "ai-agent",
    "ai-avatar",
    "conversational-ai",
    "conversational-video",
    "custom-element",
    "cvi",
    "deployments",
    "embed",
    "face-to-face",
    "inline",
    "no-backend",
    "pal",
    "real-time",
    "tavus",
    "video-agent",
    "web-component",
    "webrtc"
  ],
  "homepage": "https://docs.tavus.io/sections/deployments/embed",
  "bugs": {
    "email": "support@tavus.io"
  },
  "license": "MIT",
  "author": "Tavus, Inc.",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.iife.js",
    "./dist/index.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "vp build",
    "build:sourcemap": "vp build --sourcemap",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "npm run build -w @tavus/core && npm run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tavus/core": "*",
    "@types/react": "^19.3.0",
    "daisyui": "^5.7.32",
    "tailwindcss": "^4.2.2",
    "vite-plugin-dts": "^5.0.0",
    "vite-plugin-tailwind-shadowdom": "^1.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
